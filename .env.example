# Copy to .env.local (gitignored) and fill in locally. Never commit real values.
# Missing browser values => the app runs in demo mode (in-memory store, mock extractor).

# --- Browser (exposed to the client bundle by Vite; these two are the ONLY VITE_ names) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- SERVER-ONLY: Supabase Edge Function secrets (set in the Supabase/Bolt dashboard, never VITE_) ---
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
# optional
TYPESAFE_API_KEY=
EXTRACT_MODEL_LLM=
# planned value jev-1.13.0 (re-verify at DV-PROVIDERS)
EXTRACT_MODEL_JEV=
# planned default 5
RATE_PER_MIN_USER=
# planned default 0.10
MAX_ATTEMPT_USD=
# planned default 0.50
DAILY_USER_USD=
# planned default 2.00
DAILY_INSTALL_USD=
# planned default 20000
PROVIDER_TIMEOUT_MS=
ALLOWED_ORIGINS=

# --- SERVER-ONLY: provided by the Supabase platform inside Edge Functions ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- SERVER-ONLY / LOCAL EVAL: read by scripts/eval.ts in Node (never shipped to the browser) ---
# planned default 0.10
EVAL_MAX_ATTEMPT_USD=
# planned default 2.00 cumulative
EVAL_MAX_RUN_USD=
