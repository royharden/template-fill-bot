{
  "name": "template-fill-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fills an illustrative tenancy-agreement template from pasted messages using a hash-locked, self-authored clause library. Draft, not legal advice.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "lock": "tsx scripts/lock.ts",
    "eval": "tsx scripts/eval.ts",
    "gen-gold": "tsx scripts/gen-gold.ts",
    "demo": "tsx scripts/demo.ts",
    "syntax-check": "node scripts/syntax-check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "fflate": "0.8.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.8.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "eslint": "9.13.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.12.2",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
